diff --git a/typescript/packages/extensions/test/bazaarSchemaValidationNoCodegen.test.ts b/typescript/packages/extensions/test/bazaarSchemaValidationNoCodegen.test.ts
new file mode 100644
index 0000000..c079ba2
--- /dev/null
+++ b/typescript/packages/extensions/test/bazaarSchemaValidationNoCodegen.test.ts
@@ -0,0 +1,335 @@
+/**
+ * Regression tests for x402-foundation/x402#3446.
+ *
+ * Cloudflare Workers (workerd) forbid dynamic code generation, so any validator that
+ * relies on `new Function()` / `eval` cannot compile a schema inside a request. These
+ * tests simulate that constraint by replacing the global `Function` constructor with one
+ * that throws the same error workerd raises, and count every attempt, so a regression
+ * back to a code-generating validator fails here instead of only in production logs.
+ *
+ * No wallet, facilitator, payment or secret is involved.
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { RoutesConfig } from "@x402/core/server";
+import {
+  declareDiscoveryExtension,
+  validateBazaarRouteExtensions,
+  validateDiscoveryExtension,
+} from "../src/bazaar/index";
+import type { DiscoveryExtension } from "../src/bazaar/types";
+
+const WORKERD_MESSAGE = "Code generation from strings disallowed for this context";
+
+let codegenAttempts = 0;
+const RealFunction = globalThis.Function;
+
+/**
+ * Stand-in for the global Function constructor on a runtime that forbids code generation.
+ * Records the attempt and throws the same EvalError workerd raises.
+ *
+ * @returns Never returns; always throws
+ */
+function ForbiddenFunction(): never {
+  codegenAttempts++;
+  throw new EvalError(WORKERD_MESSAGE);
+}
+
+beforeEach(() => {
+  codegenAttempts = 0;
+  vi.stubGlobal("Function", ForbiddenFunction);
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  expect(globalThis.Function).toBe(RealFunction);
+});
+
+const validExtension: DiscoveryExtension = {
+  schema: {
+    type: "object",
+    properties: { name: { type: "string" } },
+    required: ["name"],
+  },
+  info: { name: "demo" },
+} as unknown as DiscoveryExtension;
+
+/**
+ * Builds a discovery extension whose info violates the supplied schema in a specific way.
+ *
+ * @param info - The info object to validate against a fixed name/count schema
+ * @returns A discovery extension with a strict schema and the given info
+ */
+function extensionWithInfo(info: unknown): DiscoveryExtension {
+  return {
+    schema: {
+      $schema: "https://json-schema.org/draft/2020-12/schema",
+      type: "object",
+      properties: {
+        name: { type: "string" },
+        kind: { type: "string", const: "http" },
+        count: { type: "integer", minimum: 1 },
+      },
+      required: ["name", "kind"],
+      additionalProperties: false,
+    },
+    info,
+  } as unknown as DiscoveryExtension;
+}
+
+describe("validateDiscoveryExtension without dynamic code generation (#3446)", () => {
+  it("validates a correct extension without attempting code generation", () => {
+    const result = validateDiscoveryExtension(validExtension);
+    expect(result).toEqual({ valid: true });
+    expect(codegenAttempts).toBe(0);
+  });
+
+  it("validates a declareDiscoveryExtension() result (real Bazaar schema shape)", () => {
+    const declared = declareDiscoveryExtension({
+      method: "GET",
+      input: { query: "test" },
+      inputSchema: { properties: { query: { type: "string" } } },
+    });
+    const result = validateDiscoveryExtension(declared.bazaar);
+    expect(result).toEqual({ valid: true });
+    expect(codegenAttempts).toBe(0);
+  });
+
+  it("never reports the runtime limitation as a schema error", () => {
+    const result = validateDiscoveryExtension(validExtension);
+    expect(result.errors ?? []).not.toContainEqual(expect.stringContaining(WORKERD_MESSAGE));
+  });
+
+  it("does not attempt code generation on repeated calls or distinct schemas", () => {
+    for (let i = 0; i < 25; i++) {
+      const ext = {
+        schema: { type: "object", properties: { [`field${i}`]: { type: "number" } } },
+        info: { [`field${i}`]: i },
+      } as unknown as DiscoveryExtension;
+      expect(validateDiscoveryExtension(ext).valid).toBe(true);
+    }
+    expect(codegenAttempts).toBe(0);
+  });
+
+  it("still rejects invalid info under a supported schema (no fallback to valid)", () => {
+    const missing = validateDiscoveryExtension(extensionWithInfo({ kind: "http" }));
+    expect(missing.valid).toBe(false);
+    expect(missing.errors?.some(e => e.includes("name"))).toBe(true);
+
+    const wrongType = validateDiscoveryExtension(extensionWithInfo({ name: 5, kind: "http" }));
+    expect(wrongType.valid).toBe(false);
+    expect(wrongType.errors?.some(e => e.startsWith("/name:"))).toBe(true);
+
+    const wrongConst = validateDiscoveryExtension(extensionWithInfo({ name: "a", kind: "mcp" }));
+    expect(wrongConst.valid).toBe(false);
+    expect(wrongConst.errors?.some(e => e.startsWith("/kind:"))).toBe(true);
+
+    const belowMin = validateDiscoveryExtension(
+      extensionWithInfo({ name: "a", kind: "http", count: 0 }),
+    );
+    expect(belowMin.valid).toBe(false);
+    expect(belowMin.errors?.some(e => e.startsWith("/count:"))).toBe(true);
+
+    const extra = validateDiscoveryExtension(
+      extensionWithInfo({ name: "a", kind: "http", extra: true }),
+    );
+    expect(extra.valid).toBe(false);
+
+    expect(codegenAttempts).toBe(0);
+  });
+
+  it("reports the (root) path for top-level errors, matching the previous format", () => {
+    const result = validateDiscoveryExtension(extensionWithInfo({ kind: "http" }));
+    expect(result.valid).toBe(false);
+    expect(result.errors?.some(e => e.startsWith("(root):"))).toBe(true);
+  });
+
+  it("rejects a non-object schema instead of treating it as unconstrained", () => {
+    for (const schema of [true, "x", 42, null, undefined, ["a"]]) {
+      const result = validateDiscoveryExtension({
+        schema,
+        info: { anything: 1 },
+      } as unknown as DiscoveryExtension);
+      expect(result.valid).toBe(false);
+      expect(result.errors?.[0]).toContain("schema must be a JSON Schema object");
+    }
+    expect(codegenAttempts).toBe(0);
+  });
+
+  it("still rejects external $ref/$id references before validating", () => {
+    const result = validateDiscoveryExtension({
+      schema: { type: "object", properties: { a: { $ref: "https://evil.example/s.json" } } },
+      info: { a: 1 },
+    } as unknown as DiscoveryExtension);
+    expect(result.valid).toBe(false);
+    expect(result.errors?.[0]).toContain("external $ref/$id");
+  });
+
+  it("reports an unresolvable same-document $ref as a schema failure, not as valid", () => {
+    const result = validateDiscoveryExtension({
+      schema: { type: "object", properties: { a: { $ref: "#/$defs/missing" } } },
+      info: { a: 1 },
+    } as unknown as DiscoveryExtension);
+    expect(result.valid).toBe(false);
+    expect(result.errors?.[0]).toMatch(/^Schema validation failed: /);
+    expect(result.errors?.[0]).not.toContain(WORKERD_MESSAGE);
+  });
+
+  it("reports a malformed pattern as a schema failure, not as valid", () => {
+    const result = validateDiscoveryExtension({
+      schema: { type: "object", properties: { a: { type: "string", pattern: "(" } } },
+      info: { a: "x" },
+    } as unknown as DiscoveryExtension);
+    expect(result.valid).toBe(false);
+    expect(result.errors?.[0]).toMatch(/^Schema validation failed: /);
+  });
+
+  it("rejects an unsupported $schema dialect explicitly instead of validating anyway", () => {
+    const result = validateDiscoveryExtension({
+      schema: {
+        $schema: "http://json-schema.org/draft-04/schema#",
+        type: "object",
+        properties: { a: { type: "string" } },
+      },
+      info: { a: "x" },
+    } as unknown as DiscoveryExtension);
+    expect(result.valid).toBe(false);
+    expect(result.errors?.[0]).toContain("unsupported $schema dialect");
+
+    const ok = validateDiscoveryExtension({
+      schema: {
+        $schema: "https://json-schema.org/draft/2020-12/schema",
+        type: "object",
+        properties: { a: { type: "string" } },
+      },
+      info: { a: "x" },
+    } as unknown as DiscoveryExtension);
+    expect(ok).toEqual({ valid: true });
+    expect(codegenAttempts).toBe(0);
+  });
+
+  it("enforces well-known string formats (uri, date-time)", () => {
+    // Behavior change relative to the Ajv-based implementation, which ignored `format`
+    // because ajv-formats was not installed. This is the intent of PR #3265.
+    const schema = {
+      type: "object",
+      properties: {
+        url: { type: "string", format: "uri" },
+        at: { type: "string", format: "date-time" },
+      },
+    };
+    const ok = validateDiscoveryExtension({
+      schema,
+      info: { url: "https://example.com/x", at: "2026-09-13T22:00:00Z" },
+    } as unknown as DiscoveryExtension);
+    expect(ok).toEqual({ valid: true });
+
+    const bad = validateDiscoveryExtension({
+      schema,
+      info: { url: "not a uri", at: "yesterday" },
+    } as unknown as DiscoveryExtension);
+    expect(bad.valid).toBe(false);
+    expect(bad.errors?.some(e => e.startsWith("/url:"))).toBe(true);
+    expect(bad.errors?.some(e => e.startsWith("/at:"))).toBe(true);
+    expect(codegenAttempts).toBe(0);
+  });
+});
+
+describe("validateBazaarRouteExtensions without dynamic code generation (#3446)", () => {
+  const accepts = [{ scheme: "exact", payTo: "0x1", price: "$0.01", network: "eip155:1" as const }];
+
+  const validRoute = (query: string) => ({
+    accepts,
+    extensions: declareDiscoveryExtension({
+      method: "GET",
+      input: { [query]: "x" },
+      inputSchema: { properties: { [query]: { type: "string" } } },
+    }),
+  });
+
+  const malformedRoute = {
+    accepts,
+    // Declares a bazaar extension without a schema: structurally malformed.
+    extensions: { bazaar: { info: { input: { type: "http", method: "GET" } } } },
+  };
+
+  const invalidInfoRoute = {
+    accepts,
+    extensions: {
+      bazaar: {
+        info: { input: { type: "http", method: "GET", queryParams: { q: 1 } } },
+        schema: {
+          type: "object",
+          properties: {
+            input: {
+              type: "object",
+              properties: {
+                type: { type: "string", const: "http" },
+                method: { type: "string", enum: ["GET"] },
+                queryParams: {
+                  type: "object",
+                  properties: { q: { type: "string" } },
+                },
+              },
+              required: ["type", "method"],
+            },
+          },
+          required: ["input"],
+        },
+      },
+    },
+  };
+
+  /**
+   * Runs the startup validation for a route map and returns the warnings it emitted.
+   *
+   * @param routes - Route map to validate
+   * @returns The console.warn messages emitted, in order
+   */
+  function warningsFor(routes: Record<string, unknown>): string[] {
+    const spy = vi.spyOn(console, "warn").mockImplementation(() => {});
+    try {
+      validateBazaarRouteExtensions(routes as unknown as RoutesConfig);
+      return spy.mock.calls.map(call => String(call[0]));
+    } finally {
+      spy.mockRestore();
+    }
+  }
+
+  it("keeps structural and schema checks for every route, in any order, on repeat", () => {
+    const orders: Record<string, unknown>[] = [
+      { "GET /a": validRoute("a"), "GET /b": malformedRoute, "GET /c": validRoute("c") },
+      { "GET /c": validRoute("c"), "GET /b": malformedRoute, "GET /a": validRoute("a") },
+      { "GET /b": malformedRoute, "GET /a": validRoute("a"), "GET /c": validRoute("c") },
+    ];
+
+    for (let pass = 0; pass < 2; pass++) {
+      for (const routes of orders) {
+        const warnings = warningsFor(routes);
+        expect(warnings).toHaveLength(1);
+        expect(warnings[0]).toContain('Route "GET /b"');
+        expect(warnings[0]).toContain("malformed");
+      }
+    }
+    expect(codegenAttempts).toBe(0);
+  });
+
+  it("still reports invalid info against a supported schema after valid routes", () => {
+    const warnings = warningsFor({
+      "GET /a": validRoute("a"),
+      "GET /bad": invalidInfoRoute,
+      "GET /c": validRoute("c"),
+    });
+    expect(warnings).toHaveLength(1);
+    expect(warnings[0]).toContain('Route "GET /bad"');
+    expect(warnings[0]).toContain("/input/queryParams/q");
+    expect(warnings[0]).not.toContain(WORKERD_MESSAGE);
+    expect(codegenAttempts).toBe(0);
+  });
+
+  it("emits no runtime-limitation warnings for valid routes", () => {
+    const warnings = warningsFor({ "GET /a": validRoute("a"), "POST /b": validRoute("b") });
+    expect(warnings).toEqual([]);
+    expect(codegenAttempts).toBe(0);
+  });
+});
