+describe("validateErc20ApprovalGasSponsoringInfo without dynamic code generation (#3446 follow-up)", () => {
+  const info = {
+    from: "0x" + "a".repeat(40),
+    asset: "0x" + "b".repeat(40),
+    spender: "0x" + "c".repeat(40),
+    amount: "115792089237316195423570985008687907853269984665640564039457584007913129639935",
+    signedTransaction: "0x02f8" + "ab".repeat(20),
+    version: "1",
+  };
+
+  it("returns true for valid info instead of throwing EvalError", () => {
+    // At 2.25.0 this call had no try/catch around ajv.compile(), so on a runtime that forbids
+    // code generation it threw rather than returning false.
+    expect(() => validateErc20ApprovalGasSponsoringInfo(info)).not.toThrow();
+    expect(validateErc20ApprovalGasSponsoringInfo(info)).toBe(true);
+    expect(codegenAttempts).toBe(0);
+  });
+
+  it("still rejects each malformed field via the schema's patterns", () => {
+    expect(validateErc20ApprovalGasSponsoringInfo({ ...info, from: "0x123" })).toBe(false);
+    expect(validateErc20ApprovalGasSponsoringInfo({ ...info, amount: "1.5" })).toBe(false);
+    expect(validateErc20ApprovalGasSponsoringInfo({ ...info, signedTransaction: "zz" })).toBe(
+      false,
+    );
+    expect(validateErc20ApprovalGasSponsoringInfo({ ...info, version: "v1" })).toBe(false);
+    expect(codegenAttempts).toBe(0);
+  });
+});
