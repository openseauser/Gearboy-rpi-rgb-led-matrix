diff --git a/typescript/packages/extensions/src/jsonSchema.ts b/typescript/packages/extensions/src/jsonSchema.ts
new file mode 100644
index 0000000..6f7a039
--- /dev/null
+++ b/typescript/packages/extensions/src/jsonSchema.ts
@@ -0,0 +1,205 @@
+/**
+ * Shared JSON Schema validation for extension payloads.
+ *
+ * Extension schemas are supplied at runtime (by route authors, or by clients inside a payment
+ * payload), so nothing can be precompiled at build time. Validation therefore uses an
+ * interpreting validator that never calls `new Function()` / `eval`: it behaves identically on
+ * Node, in bundlers and on runtimes that forbid dynamic code generation (Cloudflare Workers,
+ * `node --disallow-code-generation-from-strings`, strict CSP), and has no per-call compile step.
+ *
+ * @internal
+ */
+
+import { Validator, type Schema } from "@cfworker/json-schema";
+
+/**
+ * Result of validating an instance against a JSON Schema.
+ */
+export interface JsonSchemaValidationResult {
+  valid: boolean;
+  errors?: string[];
+}
+
+/**
+ * Options for {@link validateAgainstJsonSchema}.
+ */
+export interface JsonSchemaValidationOptions {
+  /**
+   * When true, well-known string formats (`uri`, `date-time`, `email`, `uuid`, ...) are
+   * asserted. Defaults to false, where `format` is an annotation only: this matches the
+   * behaviour of @x402/extensions <= 2.25.0, whose Ajv instance had no format plugin and
+   * ignored the keyword, so existing payloads keep validating the same way.
+   */
+  assertFormats?: boolean;
+}
+
+const SUPPORTED_SCHEMA_DIALECTS = new Set([
+  "https://json-schema.org/draft/2020-12/schema",
+  "https://json-schema.org/draft/2020-12/schema#",
+]);
+
+/** Keywords whose value is a map of arbitrary names to subschemas. */
+const SCHEMA_MAP_KEYWORDS = new Set([
+  "properties",
+  "patternProperties",
+  "$defs",
+  "definitions",
+  "dependentSchemas",
+]);
+/** Keywords whose value is a single subschema. */
+const SCHEMA_KEYWORDS = new Set([
+  "items",
+  "additionalItems",
+  "additionalProperties",
+  "unevaluatedProperties",
+  "unevaluatedItems",
+  "contains",
+  "propertyNames",
+  "not",
+  "if",
+  "then",
+  "else",
+  "contentSchema",
+]);
+/** Keywords whose value is an array of subschemas. */
+const SCHEMA_ARRAY_KEYWORDS = new Set(["allOf", "anyOf", "oneOf", "prefixItems"]);
+
+const formatStrippedSchemas = new WeakMap<object, Schema>();
+
+/**
+ * Recursively scans a decoded JSON Schema document for "$ref"/"$id" values that are not
+ * same-document fragments (i.e. do not start with "#").
+ *
+ * The validator throws on an unregistered absolute/relative `$ref` rather than dereferencing
+ * it, so this SDK does not fetch or read anything by default. This guard exists for
+ * defense-in-depth and to give a consistent, explicit rejection message across all x402 SDKs,
+ * since schema is client-controlled (it arrives in the payment payload) and any external
+ * $ref/$id is a CWE-918 SSRF / local file disclosure pattern other JSON Schema tooling
+ * (including validators with remote schema loading) can act on.
+ *
+ * @param node - The (sub)tree of a decoded JSON Schema document to scan
+ * @returns True if any non-fragment "$ref"/"$id" value is found
+ */
+export function hasExternalSchemaReference(node: unknown): boolean {
+  if (Array.isArray(node)) {
+    return node.some(item => hasExternalSchemaReference(item));
+  }
+  if (node && typeof node === "object") {
+    for (const [key, value] of Object.entries(node as Record<string, unknown>)) {
+      if (key === "$ref" || key === "$id") {
+        if (typeof value !== "string" || !value.startsWith("#")) {
+          return true;
+        }
+      }
+      if (hasExternalSchemaReference(value)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+/**
+ * Returns a copy of `schema` with every `format` keyword removed from keyword positions.
+ * Property names, `const`/`enum`/`default` values and other data are left untouched, so a
+ * property literally called "format" is still validated.
+ *
+ * @param node - The schema (or subschema) to copy
+ * @returns The copy without format assertions; non-object nodes are returned as-is
+ */
+function withoutFormatAssertions(node: unknown): unknown {
+  if (typeof node !== "object" || node === null) return node;
+  if (Array.isArray(node)) return node.map(withoutFormatAssertions);
+  const out: Record<string, unknown> = {};
+  for (const [key, value] of Object.entries(node as Record<string, unknown>)) {
+    if (key === "format") continue;
+    if (SCHEMA_MAP_KEYWORDS.has(key) && typeof value === "object" && value !== null) {
+      const map: Record<string, unknown> = {};
+      for (const [name, sub] of Object.entries(value as Record<string, unknown>)) {
+        map[name] = withoutFormatAssertions(sub);
+      }
+      out[key] = map;
+    } else if (
+      SCHEMA_KEYWORDS.has(key) ||
+      (SCHEMA_ARRAY_KEYWORDS.has(key) && Array.isArray(value))
+    ) {
+      out[key] = withoutFormatAssertions(value);
+    } else {
+      out[key] = value;
+    }
+  }
+  return out;
+}
+
+/**
+ * Validates `instance` against `schema` (JSON Schema 2020-12) without runtime code generation.
+ *
+ * Rejects explicitly, before validating: a non-object schema (the interpreter would treat it as
+ * unconstrained), a declared `$schema` other than 2020-12 (Ajv used to refuse these at compile
+ * time), and any external `$ref`/`$id` (client-controlled schemas must never trigger a fetch).
+ * Numeric `multipleOf` uses the interpreter's semantics: a fractional divisor is accepted when
+ * the quotient is within ~1.2e-7 of an integer (0.3 is a multiple of 0.1); the previous Ajv-based
+ * implementation compared the raw IEEE-754 quotient and rejected such pairs.
+ *
+ * @param schema - The JSON Schema to validate against (untrusted)
+ * @param instance - The value to validate
+ * @param options - Optional validation switches
+ * @returns `{ valid: true }` or `{ valid: false, errors }` with `"(root): ..."` / `"/path: ..."` entries
+ */
+export function validateAgainstJsonSchema(
+  schema: unknown,
+  instance: unknown,
+  options: JsonSchemaValidationOptions = {},
+): JsonSchemaValidationResult {
+  try {
+    if (typeof schema !== "object" || schema === null || Array.isArray(schema)) {
+      return { valid: false, errors: ["schema must be a JSON Schema object"] };
+    }
+
+    const dialect = (schema as { $schema?: unknown }).$schema;
+    if (
+      dialect !== undefined &&
+      !(typeof dialect === "string" && SUPPORTED_SCHEMA_DIALECTS.has(dialect))
+    ) {
+      return {
+        valid: false,
+        errors: [
+          `schema declares an unsupported $schema dialect ${JSON.stringify(dialect)}; ` +
+            "only JSON Schema 2020-12 is supported",
+        ],
+      };
+    }
+
+    if (hasExternalSchemaReference(schema)) {
+      return { valid: false, errors: ["schema must not contain external $ref/$id references"] };
+    }
+
+    let effectiveSchema = schema as Schema;
+    if (!options.assertFormats) {
+      let stripped = formatStrippedSchemas.get(schema);
+      if (!stripped) {
+        stripped = withoutFormatAssertions(schema) as Schema;
+        formatStrippedSchemas.set(schema, stripped);
+      }
+      effectiveSchema = stripped;
+    }
+
+    const result = new Validator(effectiveSchema, "2020-12", false).validate(instance);
+    if (result.valid) {
+      return { valid: true };
+    }
+    const errors = result.errors.map(err => {
+      // "#/input/method" -> "/input/method"; "#" -> "(root)"
+      const path = err.instanceLocation.replace(/^#/, "") || "(root)";
+      return `${path}: ${err.error}`;
+    });
+    return { valid: false, errors: errors.length > 0 ? errors : ["Unknown validation error"] };
+  } catch (error) {
+    return {
+      valid: false,
+      errors: [
+        `Schema validation failed: ${error instanceof Error ? error.message : String(error)}`,
+      ],
+    };
+  }
+}
